# DataForSEO API credentials (app.dataforseo.com -> API Access)
DFS_LOGIN=you@example.com
DFS_PASSWORD=your-api-password

# Reuse a saved snapshot instead of paying again if it is younger than this
CACHE_DAYS=7

# Rows requested per lookup (more rows = more cost)
KEYWORD_LIMIT=100
COMPETITOR_LIMIT=20
PAGE_LIMIT=20

# Set to 1 to run with bundled sample data and no API calls
DFS_MOCK=0

# Max parallel DataForSEO requests
DFS_CONCURRENCY=2

# Competitor gap: rows per competitor and minimum search volume for content-gap keywords
COMPARE_SHARED_LIMIT=200
COMPARE_MISSING_LIMIT=200
COMPARE_LINKGAP_LIMIT=200
COMPARE_MIN_VOLUME=10
# A lost keyword counts as "off-page" if the competitor's domain rank is >= 1.25x yours
# or its ranking page has >= 2x your page's referring domains
OFFPAGE_DOMAIN_RATIO=1.25
OFFPAGE_PAGE_RATIO=2.0

# Internal-linking crawler: max pages per crawl
CRAWL_MAX_PAGES=2000

# Search Console (Strength tab). Service account must be a user on the property.
GSC_SITE_URL=sc-domain:serenitybrides.com
GSC_KEY_FILE=/secrets/gsc-key.json
GSC_DAYS=90
# Opportunity multiplier per product line (bridal first, then MOB)
LINE_WEIGHTS=bridal=1,mob=0.6,bridesmaids=0.4,general=0.5,accessories=0.2
# Discontinued ranges (last stock): still linkable while unsold, links flagged temporary; path globs
DISCONTINUED=/collections/mother-of-the-bride/jacques-vert,/dresses/jacques-vert-*,/collections/bridal/sophia-tolli,/dresses/sophia-tolli-*
