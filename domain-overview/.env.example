# DataForSEO API credentials (app.dataforseo.com -> API Access)
DFS_LOGIN=you@example.com
DFS_PASSWORD=your-api-password

# Reuse a saved snapshot instead of paying again if it is younger than this
CACHE_DAYS=7

# Rows requested per lookup (more rows = more cost)
KEYWORD_LIMIT=100
COMPETITOR_LIMIT=20
PAGE_LIMIT=20

# Set to 1 to run with bundled sample data and no API calls
DFS_MOCK=0
